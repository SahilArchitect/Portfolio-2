# Copy to apps/web/.env (for local development) and fill in.
# On Vercel, set the same variables in Project Settings -> Environment Variables.

# --- Database (required) ---------------------------------------------------
# Postgres connection string. Locally: the docker-compose service below.
# Production: the pooled Neon connection string from the Vercel Marketplace integration.
DATABASE_URL=postgres://site:site@localhost:5432/site

# --- Site ----------------------------------------------------------------
# Canonical origin used for canonical URLs, sitemap, RSS, OG images, BibTeX.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth (required for /admin) -------------------------------------
# Random 32+ byte secret for Auth.js. Generate: openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App (https://github.com/settings/developers -> New OAuth App).
# Callback URL: <site origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# The only account allowed to sign in: github:<numeric GitHub user id>.
# Find yours with: gh api user --jq .id
ADMIN_ALLOWED_IDENTITY=github:26546141

# --- File storage (required in production) ---------------------------------
# Vercel Blob read/write token (created automatically when a Blob store is
# connected to the project). Leave empty locally to store files in apps/web/.data/.
BLOB_READ_WRITE_TOKEN=

# --- Analytics (optional, off by default) -----------------------------------
# Set to "true" to load Vercel Web Analytics (cookieless). No banner needed.
NEXT_PUBLIC_ANALYTICS=false
