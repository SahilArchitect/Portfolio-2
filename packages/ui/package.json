{
  "name": "@engine-room/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["./src/styles/*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./motion": {
      "types": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    },
    "./tailwind-preset": {
      "types": "./src/tailwind-preset.ts",
      "default": "./src/tailwind-preset.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/cursor.css": "./src/styles/cursor.css"
  },
  "scripts": {
    "lint": "echo \"(no lint configured for ui yet)\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "framer-motion": "^11.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
