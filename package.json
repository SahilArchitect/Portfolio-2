{
  "name": "bysahil",
  "version": "1.0.0",
  "private": true,
  "description": "Sahil Bhatti's research website (bysahil.dev) with an embedded owner-only admin.",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @bysahil/web dev",
    "build": "pnpm --filter @bysahil/web build",
    "start": "pnpm --filter @bysahil/web start",
    "lint": "pnpm --filter @bysahil/web lint",
    "typecheck": "pnpm --filter @bysahil/web typecheck",
    "test": "pnpm --filter @bysahil/web test",
    "test:e2e": "pnpm --filter @bysahil/web test:e2e",
    "db:migrate": "pnpm --filter @bysahil/web db:migrate",
    "db:seed": "pnpm --filter @bysahil/web db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
