# The Engine Room local development environment.
# Copy to repo root with: cp infra/.env.example .env
# Keep this file in sync with infra/.env.production.example when adding vars.

ENVIRONMENT=development

# Domains / local ports
DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
ACME_EMAIL=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=3001

# Postgres + Redis
POSTGRES_USER=engine_room
POSTGRES_PASSWORD=engine_room
POSTGRES_DB=engine_room
DATABASE_URL=postgresql+asyncpg://engine_room:engine_room@localhost:5432/engine_room
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ADMIN_TOKEN=dev-admin-token-change-me
PUBLIC_API_BASE_URL=http://localhost:8000
RESUME_UPLOAD_DIR=storage/uploads
DEFAULT_FLAGS={}

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SUBSTACK_FEED_URL=

# Public web + server-side Next.js calls
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CALENDLY_LINK=sahilbhatti/intro
API_INTERNAL_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
ALLOW_API_FETCH_DURING_BUILD=false
USE_API_FALLBACKS=false

# Admin auth
ADMIN_EMAIL=sahil@bysahil.dev
AUTH_SECRET=dev-secret-change-me
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
RESEND_API_KEY=
EMAIL_FROM=sahil@bysahil.dev

# OpenTelemetry
OTEL_SERVICE_NAME=engine-room-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_COLLECTOR_TRACES_EXPORTER=debug
OTEL_COLLECTOR_EXPORT_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_EXPORT_OTLP_AUTHORIZATION=
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# Backups to S3-compatible storage
BACKUP_DATABASE_URL=postgresql://engine_room:engine_room@localhost:5432/engine_room
S3_ENDPOINT_URL=
S3_BUCKET=
S3_PREFIX=engine-room/postgres
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
