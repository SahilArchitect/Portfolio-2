# The Engine Room production environment template.
# Copy to infra/.env.production for docker compose, or map these as platform secrets.
# Do not commit real secrets.

ENVIRONMENT=production

# Domains
DOMAIN=bysahil.dev
ADMIN_DOMAIN=admin.bysahil.dev
ACME_EMAIL=sahil@bysahil.dev

# Postgres + Redis
POSTGRES_USER=engine_room
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=engine_room
DATABASE_URL=postgresql+asyncpg://engine_room:change-me-long-random-password@postgres:5432/engine_room
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["https://bysahil.dev","https://admin.bysahil.dev"]
ADMIN_TOKEN=change-me-long-random-admin-token
PUBLIC_API_BASE_URL=https://bysahil.dev
RESUME_UPLOAD_DIR=storage/uploads
DEFAULT_FLAGS={}

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SUBSTACK_FEED_URL=https://example.substack.com/feed

# Public web + server-side Next.js calls
NEXT_PUBLIC_SITE_URL=https://bysahil.dev
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CAL_LINK=sahilbhatti/intro
API_INTERNAL_BASE_URL=http://api:8000
API_BASE_URL=http://api:8000
ALLOW_API_FETCH_DURING_BUILD=false
USE_API_FALLBACKS=false

# Admin auth
ADMIN_EMAIL=sahil@bysahil.dev
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=https://admin.bysahil.dev
AUTH_TRUST_HOST=true
RESEND_API_KEY=
EMAIL_FROM=sahil@bysahil.dev

# OpenTelemetry
OTEL_SERVICE_NAME=engine-room-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_COLLECTOR_TRACES_EXPORTER=debug
OTEL_COLLECTOR_EXPORT_OTLP_ENDPOINT=https://otel-vendor.example.com
OTEL_COLLECTOR_EXPORT_OTLP_AUTHORIZATION="Bearer change-me"
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# Backups to S3-compatible storage
BACKUP_DATABASE_URL=postgresql://engine_room:change-me-long-random-password@postgres:5432/engine_room
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET=engine-room-backups
S3_PREFIX=engine-room/postgres
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
